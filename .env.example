# MediaBot 設定範本（docs/PLAN.md §9.1）
# 複製為 .env 後填值；.env 權限設為 600，不可提交到 git。
# 註解一律獨立成行，不寫在值的後面。

# ===== 模式 =====
# standalone     ：Phase 1，Mac mini 執行全部服務
# hybrid-vps     ：Phase 2，VPS 執行 bot 與 queue-server
# hybrid-worker  ：Phase 2，Mac mini 執行 worker 與 fileserver
MODE=standalone

# ===== Telegram（standalone 與 hybrid-vps 才需要；hybrid-worker 不可設定）=====
TG_BOT_TOKEN=
# 以逗號分隔的 Telegram user id
ALLOWED_USER_IDS=

# ===== 路徑 =====
VAULT_DIR=/Users/mediabot/MediaVault

# ===== 檔案伺服器 =====
FILESERVER_BIND=127.0.0.1:8080
PUBLIC_BASE_URL=https://mac-mini.your-tailnet.ts.net
# 產生方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
LINK_SECRET=
LINK_TTL_SECONDS=86400

# ===== 資源上限 =====
# 4 GB
MAX_FILESIZE_BYTES=4294967296
# 3 小時
MAX_DURATION_SECONDS=10800
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=7200
RATE_LIMIT_PER_HOUR=30
FILE_RETENTION_DAYS=14

# ===== Phase 2 =====
# sqlite | remote
QUEUE_BACKEND=sqlite
# 例如 https://vps-name.your-tailnet.ts.net
QUEUE_REMOTE_URL=
WORKER_API_TOKEN=
WORKER_ID=mac-mini
LEASE_SECONDS=900
MAX_ATTEMPTS=3
HEARTBEAT_ALERT_MINUTES=30
